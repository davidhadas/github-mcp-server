# GitHub OAuth Configuration
# Required for MCP Server OAuth authentication
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_client_secret_here

# GitHub Personal Access Token
# Required for pushing container images to GitHub Container Registry (ghcr.io)
# Token needs the following scopes:
#   - packages:read
#   - packages:write
#   - packages:delete (optional, for cleanup)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Instructions:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual credentials
# 3. Never commit .env to git (it's in .gitignore)