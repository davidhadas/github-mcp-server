# Multi-stage Dockerfile for Envoy Demo Components
# Builds: token-broker, backend-envoy, aiagent, and github-mcp-server

FROM golang:1.25-alpine AS build
ARG VERSION="dev"
ARG BUILD_TIME="unknown"

# Set the working directory
WORKDIR /build

# Install git
RUN --mount=type=cache,target=/var/cache/apk \
    apk add git

# Copy source code
COPY . .

# Build all binaries
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION} -X main.commit=$(git rev-parse HEAD) -X main.date=${BUILD_TIME}" \
    -o /bin/token-broker ./cmd/token-broker && \
    CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION} -X main.commit=$(git rev-parse HEAD) -X main.date=${BUILD_TIME}" \
    -o /bin/backend-envoy ./cmd/backend-envoy && \
    CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION} -X main.commit=$(git rev-parse HEAD) -X main.date=${BUILD_TIME}" \
    -o /bin/aiagent ./cmd/aiagent && \
    CGO_ENABLED=0 go build -ldflags="-s -w -X main.version=${VERSION} -X main.commit=$(git rev-parse HEAD) -X main.date=${BUILD_TIME}" \
    -o /bin/github-mcp-server ./cmd/github-mcp-server

# Final stage - all binaries in one image
FROM gcr.io/distroless/base-debian12@sha256:937c7eaaf6f3f2d38a1f8c4aeff326f0c56e4593ea152e9e8f74d976dde52f56

# Set the working directory
WORKDIR /app

# Copy all binaries from the build stage
COPY --from=build /bin/token-broker /token-broker
COPY --from=build /bin/backend-envoy /backend-envoy
COPY --from=build /bin/aiagent /aiagent
COPY --from=build /bin/github-mcp-server /github-mcp-server

# Run as nonroot user
USER nonroot:nonroot

# Default entrypoint (can be overridden in k8s manifests)
ENTRYPOINT ["/token-broker"]

